[Unit]
Description=Frix TeamSpeak music bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frix
Group=frix
WorkingDirectory=/opt/frix
ExecStart=/opt/frix/frix.sh
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Güvenlik sıkılaştırma
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
